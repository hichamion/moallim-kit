rules_version = '2';

// Moallim Kit: every teacher reads and writes only their own data.
// users/{uid}             -> sync metadata (revision, updatedAt, chunk count)
// users/{uid}/chunks/{n}  -> the teacher's data, split in pieces under the 1 MB document limit
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['revision', 'updatedAt', 'chunks', 'chars', 'device'])
        && request.resource.data.revision is int
        && request.resource.data.chunks is int
        && request.resource.data.chunks <= 40;

      match /chunks/{chunkId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['text'])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 900000;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
